async function svgExport(){const total=state.levels.reduce((a,b)=>a+b.thickness,0)||1,W=680,H=780,top=88,bottom=710,usable=bottom-top,scale=usable/total;let defs='',layers='',y=bottom;const used=[...new Set(state.levels.map(x=>String(x.lith)))];for(const c of used){let href=patternSvg(c);try{const r=await fetch(href);if(r.ok){const txt=await r.text();href='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(txt)}}catch(_){}defs+=`<pattern id="p${c}" patternUnits="userSpaceOnUse" width="60" height="60"><image href="${href}" width="60" height="60"/></pattern>`}state.levels.forEach(x=>{const h=Math.max(4,x.thickness*scale);y-=h;layers+=`<rect x="155" y="${y}" width="225" height="${h}" fill="url(#p${x.lith})" stroke="#29495d"/><text x="392" y="${y+h/2}" font-size="11" dominant-baseline="middle">${esc(x.code)} · FGDC ${x.lith} · ${esc(LITH[x.lith]?.name)} · ${x.thickness.toFixed(2)} m</text>`});const g=state.gps||{};const pos=Number.isFinite(g.lat)&&Number.isFinite(g.lon)?`WGS 84 · ${g.lat.toFixed(6)}, ${g.lon.toFixed(6)}${Number.isFinite(g.accuracy)?` · precisão ±${Math.round(g.accuracy)} m`:''}`:'GPS não registrado';const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}"><defs>${defs}</defs><rect width="100%" height="100%" fill="white"/><text x="340" y="28" text-anchor="middle" font-family="Arial" font-size="20" font-weight="700">${esc(state.project)}</text><text x="340" y="48" text-anchor="middle" font-family="Arial" font-size="11">${esc(state.place)} · ${esc(state.orientation||'orientação não informada')}</text><text x="340" y="66" text-anchor="middle" font-family="Arial" font-size="10">${esc(pos)}</text><text x="340" y="80" text-anchor="middle" font-family="Arial" font-size="9">ITA ARANDU MS · FGDC-STD-013-2006 · Section 37</text>${layers}</svg>`;download('coluna_estratigrafica.svg','image/svg+xml',svg)}
