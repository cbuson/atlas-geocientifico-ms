<section class="ce-pane" data-ce-pane="help"><div class="ce-help-grid"><div class="ce-help-card"><h3>O que é uma coluna estratigráfica</h3><p>Representa verticalmente uma sucessão de unidades ou níveis observados, permitindo registrar espessuras, litologias, contatos, estruturas, fósseis e amostras. A posição vertical é observacional e não deve ser confundida automaticamente com idade absoluta.</p></div><div class="ce-help-card"><h3>Como usar</h3><ol><li>Defina a base da seção.</li><li>Meça a espessura do nível.</li><li>Descreva litologia e textura.</li><li>Registre estruturas, fósseis e contatos.</li><li>Adicione o nível e repita para a unidade sobrejacente.</li></ol></div><div class="ce-help-card"><h3>Para que serve</h3><p>Levantamento de seções, sedimentologia, estratigrafia, análise de fácies, comparação entre afloramentos, documentação de testemunhos e apoio à interpretação paleoambiental e geotécnica.</p></div><div class="ce-help-card"><h3>Observação ≠ interpretação</h3><p>“Arenito fino com estratificação cruzada” é uma observação. Uma interpretação de ambiente deposicional exige contexto adicional. A ferramenta mantém os dois níveis de informação separados.</p></div><div class="ce-help-card"><h3>Posição GPS da seção</h3><p>Use o GPS para registrar o ponto de referência da coluna. A ferramenta guarda latitude e longitude em WGS 84, a precisão horizontal reportada pelo dispositivo, altitude quando disponível e o horário da leitura. A precisão deve ser registrada junto com a coordenada porque uma posição de celular possui incerteza.</p></div><div class="ce-help-card"><h3>Por que registrar a posição</h3><p>A coordenada permite relacionar a coluna ao afloramento, estação de campo, fotografias, amostras e futuras correlações. O GPS identifica o ponto de referência do levantamento e não substitui o registro de orientação, extensão ou geometria da seção.</p></div><div class="ce-help-card"><h3>Norma de simbologia</h3><p>O FGDC-STD-013-2006 reserva os padrões litológicos das séries 600 e 700 para colunas, seções e cartas. A biblioteca preserva os 117 códigos oficiais da Seção 37. A conversão web de Daven Quinn disponibiliza os vetores correspondentes. Para maior compatibilidade entre navegadores, esta interface usa PNG gerado localmente a partir desses SVG e preserva os vetores originais. Os códigos 710, 718 e 733 permanecem documentados, mas não recebem desenho substituto nem padrão inventado.</p></div><div class="ce-help-card"><h3>Limitações</h3><p>A qualidade depende da medição de espessura, exposição, identificação litológica e continuidade da seção. A coluna não corrige automaticamente hiatos, falhas, repetição tectônica nem espessura aparente causada pela geometria do afloramento.</p></div></div><div class="ce-card" style="margin-top:14px"><h3>Referências APA 7</h3><div class="ce-ref">Federal Geographic Data Committee. (2006). <i>FGDC Digital Cartographic Standard for Geologic Map Symbolization</i> (FGDC-STD-013-2006). Federal Geographic Data Committee.</div><div class="ce-ref">Quinn, D. (2017). <i>FGDC geologic patterns for the web</i> [Conjunto de padrões SVG/PNG].</div><div class="ce-ref">StraboSpot. (2026). <i>StraboField</i> [Software de campo geológico].</div><div class="ce-ref">Lafayette College. (2015). <i>StratLogger user manual</i>.</div><p><a href="./referencias/" target="_blank" rel="noopener">Ver referências completas na Biblioteca APA 7 →</a></p></div></section>
</div></div>`;document.body.appendChild(el);bind();render();}
function options(){const s=$('#ceLith');s.innerHTML=Object.entries(LITH).map(([c,v])=>`<option value="${c}" ${v.available===false?'disabled':''}>${c} · ${v.name}${v.available===false?' · SVG não disponível nesta fonte':''}</option>`).join('');}
function bind(){options();$$('[data-ce-tab]').forEach(b=>b.addEventListener('click',()=>tab(b.dataset.ceTab)));$$('[data-ce-close]').forEach(b=>b.addEventListener('click',close));$('#ceSave').onclick=upsert;$('#ceReset').onclick=resetForm;$('#ceDelete').onclick=del;$('#ceProject').oninput=e=>{state.project=e.target.value;save();render()};$('#cePlace').oninput=e=>{state.place=e.target.value;save()};$('#ceOrientation').oninput=e=>{state.orientation=e.target.value;save()};$('#ceUseGPS').onclick=useGPS;$('#ceLat').onchange=manualGPS;$('#ceLon').onchange=manualGPS;$('#ceExportCSV').onclick=csv;$('#ceExportJSON').onclick=jsonExport;$('#ceExportSVG').onclick=svgExport;$('#cePatternSearch').oninput=renderLibrary;$('#cePatternGroup').onchange=renderLibrary;}
function manualGPS(){const lat=Number(String($('#ceLat').value).replace(',','.')),lon=Number(String($('#ceLon').value).replace(',','.'));state.gps=state.gps||{};state.gps.lat=Number.isFinite(lat)?lat:null;state.gps.lon=Number.isFinite(lon)?lon:null;state.gps.accuracy=null;state.gps.altitude=null;state.gps.timestamp=Date.now();save();renderGps()}
function renderGps(){if(!$('#ceGpsStatus'))return;const g=state.gps||{};$('#ceLat').value=Number.isFinite(g.lat)?g.lat.toFixed(6):'';$('#ceLon').value=Number.isFinite(g.lon)?g.lon.toFixed(6):'';let t='GPS ainda não registrado.';if(Number.isFinite(g.lat)&&Number.isFinite(g.lon)){t=`${g.lat.toFixed(6)}, ${g.lon.toFixed(6)}`;if(Number.isFinite(g.accuracy))t+=` · precisão reportada ±${Math.round(g.accuracy)} m`;if(Number.isFinite(g.altitude))t+=` · altitude ${g.altitude.toFixed(1)} m`;if(g.timestamp)t+=` · ${new Date(g.timestamp).toLocaleString('pt-BR')}`}$('#ceGpsStatus').textContent=t}
function useGPS(){const st=$('#ceGpsStatus');if(!navigator.geolocation){st.textContent='Geolocalização não disponível neste navegador.';return}st.textContent='Obtendo posição…';navigator.geolocation.getCurrentPosition(p=>{state.gps={lat:p.coords.latitude,lon:p.coords.longitude,accuracy:Number.isFinite(p.coords.accuracy)?p.coords.accuracy:null,altitude:Number.isFinite(p.coords.altitude)?p.coords.altitude:null,timestamp:p.timestamp||Date.now()};save();renderGps()},err=>{const msg={1:'Permissão de localização negada.',2:'Posição indisponível.',3:'Tempo esgotado ao obter a posição.'};st.textContent=msg[err.code]||'Não foi possível obter a posição.'},{enableHighAccuracy:true,timeout:15000,maximumAge:0})}
function tab(t){$$('.ce-tabs button').forEach(x=>x.classList.toggle('active',x.dataset.ceTab===t));$$('.ce-pane').forEach(x=>x.classList.toggle('active',x.dataset.cePane===t));if(t==='data')$('#ceJSON').textContent=JSON.stringify(state,null,2)}
function form(){return{thickness:+$('#ceThickness').value||0,code:$('#ceCode').value.trim()||`Nível ${String(state.levels.length+1).padStart(2,'0')}`,lith:$('#ceLith').value,grain:$('#ceGrain').value,structures:$('#ceStructures').value.trim(),fossils:$('#ceFossils').value.trim(),contactBottom:$('#ceContactBottom').value,contactTop:$('#ceContactTop').value,notes:$('#ceNotes').value.trim()}}
function upsert(){const x=form();if(!(x.thickness>0)){alert('Informe uma espessura maior que zero.');return}if(state.selected!==null)state.levels[state.selected]=x;else state.levels.push(x);state.selected=null;save();resetForm();render()}
function resetForm(){state.selected=null;$('#ceThickness').value='1';$('#ceCode').value='';$('#ceStructures').value='';$('#ceFossils').value='';$('#ceNotes').value='';render()}
function del(){if(state.selected===null)return;if(confirm('Excluir este nível?')){state.levels.splice(state.selected,1);state.selected=null;save();resetForm();render()}}
function edit(i){state.selected=i;const x=state.levels[i];$('#ceThickness').value=x.thickness;$('#ceCode').value=x.code;$('#ceLith').value=x.lith;$('#ceGrain').value=x.grain;$('#ceStructures').value=x.structures;$('#ceFossils').value=x.fossils;$('#ceContactBottom').value=x.contactBottom;$('#ceContactTop').value=x.contactTop;$('#ceNotes').value=x.notes;render()}
function renderLibrary(){const box=$('#ceLibrary');if(!box)return;const q=($('#cePatternSearch')?.value||'').trim().toLowerCase(),g=$('#cePatternGroup')?.value||'';const rows=Object.entries(LITH).filter(([c,v])=>(!g||v.group===g)&&(!q||c.includes(q)||v.name.toLowerCase().includes(q)||v.fgdc.toLowerCase().includes(q)));box.innerHTML=rows.map(([c,v])=>`<div class="ce-pattern-card ${v.available===false?'ce-pattern-unavailable':''}"><div class="ce-pattern-preview" style="background-image:${pat(c)}">${v.available===false?'<span class="ce-no-svg">SVG não disponível<br>nesta conversão web</span>':''}</div><b>${c} · ${v.name}</b><small>${v.group}</small><small class="ce-official-name">FGDC · ${v.fgdc}</small>${v.available===false?'<small class="ce-source-note">Código oficial preservado sem desenho substituto.</small>':`<button class="ce-mini-btn" data-ce-use-pattern="${c}">Usar padrão</button>`}</div>`).join('')||'<p class="ce-note">Nenhum padrão encontrado.</p>';$('#cePatternStatus').textContent=`${rows.length} de ${Object.keys(LITH).length} padrões`;$$('[data-ce-use-pattern]').forEach(b=>b.onclick=()=>{tab('build');$('#ceLith').value=b.dataset.ceUsePattern});}
function render(){if(!$('#colunaEstratigraficaModal'))return;$('#ceProject').value=state.project;$('#cePlace').value=state.place;$('#ceOrientation').value=state.orientation;renderGps();$('#ceTitle').textContent=state.project||'Coluna estratigráfica';const total=state.levels.reduce((a,b)=>a+b.thickness,0);const px=total?Math.min(42,460/total):40;$('#ceStack').innerHTML=state.levels.map((x,i)=>`<div class="ce-layer ${i===state.selected?'selected':''}" data-i="${i}" style="height:${Math.max(34,x.thickness*px)}px;background-image:${pat(x.lith)}"><div class="ce-layer-contact ${String(x.contactTop).toLowerCase().replaceAll(' ','-')}"></div><span class="ce-layer-label">${x.code}<br>${LITH[x.lith]?.name||x.lith}<br>${x.thickness.toFixed(2)} m</span></div>`).join('');$$('.ce-layer').forEach(e=>e.onclick=()=>edit(+e.dataset.i));$('#ceLevels').innerHTML=state.levels.map((x,i)=>`<div class="ce-level-item ${i===state.selected?'active':''}" data-i="${i}"><b>${x.code}</b><small>${x.thickness.toFixed(2)} m · ${LITH[x.lith]?.name||x.lith}</small><div class="ce-pattern-chip"><span class="ce-pattern-swatch" style="background-image:${pat(x.lith)}"></span><small>FGDC ${x.lith}</small></div></div>`).join('')||'<p class="ce-note">Nenhum nível adicionado.</p>';$$('.ce-level-item').forEach(e=>e.onclick=()=>edit(+e.dataset.i));$('#ceN').textContent=state.levels.length;$('#ceTotal').textContent=total.toFixed(2).replace('.',',');const sums={};state.levels.forEach(x=>sums[x.lith]=(sums[x.lith]||0)+x.thickness);const dom=Object.entries(sums).sort((a,b)=>b[1]-a[1])[0];$('#ceDom').textContent=dom?LITH[dom[0]].name:'—';$('#ceScale').innerHTML='';if(total){for(let m=0;m<=Math.ceil(total);m++){const s=document.createElement('span');s.textContent=m+' m';s.style.bottom=(m*px)+'px';$('#ceScale').appendChild(s)}}renderLibrary();}
function esc(x){return String(x??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')}
function download(name,type,text){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function csv(){const h=['ordem','codigo','espessura_m','fgdc','litologia','granulometria','estruturas','fosseis','contato_inferior','contato_superior','observacoes','latitude_wgs84','longitude_wgs84','precisao_reportada_m','altitude_m','gps_timestamp'];const g=state.gps||{};const rows=state.levels.map((x,i)=>[i+1,x.code,x.thickness,x.lith,LITH[x.lith]?.name,x.grain,x.structures,x.fossils,x.contactBottom,x.contactTop,x.notes,g.lat??'',g.lon??'',g.accuracy??'',g.altitude??'',g.timestamp??'']);download('coluna_estratigrafica.csv','text/csv;charset=utf-8','\ufeff'+[h,...rows].map(r=>r.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(';')).join('\n'))}
