(()=>{'use strict';
const $=id=>document.getElementById(id), norm=x=>((x%360)+360)%360, rad=x=>x*Math.PI/180, deg=x=>x*180/Math.PI;
const S={active:false,gpsActive:false,heading:null,tilt:null,beta:null,gamma:null,absolute:false,source:'—',samples:[],gps:null,watch:null,decl:null,declSource:'Manual',locked:false,lastEvent:null};
function dir16(v){if(!Number.isFinite(v))return '—';const a=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];return a[Math.round(norm(v)/22.5)%16]}
function circStats(xs){const a=xs.filter(Number.isFinite);if(!a.length)return {mean:null,sd:null};let c=0,s=0;for(const x of a){c+=Math.cos(rad(x));s+=Math.sin(rad(x))}c/=a.length;s/=a.length;const R=Math.min(1,Math.hypot(c,s));return {mean:norm(deg(Math.atan2(s,c))),sd:R>0?deg(Math.sqrt(Math.max(0,-2*Math.log(R)))):180}}
function planeTilt(beta,gamma){if(!Number.isFinite(beta)||!Number.isFinite(gamma))return null;const cb=Math.cos(rad(beta)),cg=Math.cos(rad(gamma));return deg(Math.acos(Math.max(-1,Math.min(1,cb*cg))))}
function screenAngle(){const a=screen.orientation?.angle;return Number.isFinite(a)?a:(Number(window.orientation)||0)}
function headingFrom(e){if(Number.isFinite(e.webkitCompassHeading))return {h:norm(e.webkitCompassHeading),abs:true,src:'webkitCompassHeading'};if(Number.isFinite(e.alpha)){const h=norm(360-e.alpha+screenAngle());return {h,abs:!!e.absolute,src:e.absolute?'deviceorientationabsolute':'deviceorientation'}}return {h:null,abs:false,src:'indisponível'}}
function quality(){const q=circStats(S.samples.slice(-20));if(!Number.isFinite(q.sd))return {label:'Aguardando',cls:'warn',sd:null};if(q.sd<=2.5)return {label:'Boa',cls:'',sd:q.sd};if(q.sd<=7)return {label:'Aceitável',cls:'warn',sd:q.sd};return {label:'Instável',cls:'bad',sd:q.sd}}
function trueHeading(){return Number.isFinite(S.heading)&&Number.isFinite(S.decl)?norm(S.heading+S.decl):null}
function buildTicks(){let out='';for(let a=0;a<360;a+=5)out+=`<i class="bp14-tick ${a%30===0?'major':''}" style="transform:translate(-50%,-100%) rotate(${a}deg)"></i>`;for(const [a,t] of [[0,'0'],[30,'30'],[60,'60'],[90,'90'],[120,'120'],[150,'150'],[180,'180'],[210,'210'],[240,'240'],[270,'270'],[300,'300'],[330,'330']]){const rr=42,x=50+rr*Math.sin(rad(a)),y=50-rr*Math.cos(rad(a));out+=`<span class="bp14-deg" style="left:${x}%;top:${y}%">${t}</span>`}return out}
function html(){return `<div class="modal-box ita-bp14"><header class="bp14-head"><div><div class="bp14-kicker">BANCADA DIGITAL · ORIENTAÇÃO</div><h2>Bússola geológica</h2></div><button class="bp14-back" id="bp14Back" type="button">← Bancada</button></header><nav class="bp14-tabs"><button class="bp14-tab active" data-bp14-tab="measure">Medir</button><button class="bp14-tab" data-bp14-tab="data">Dados</button><button class="bp14-tab" data-bp14-tab="north">Norte</button><button class="bp14-tab" data-bp14-tab="help">Ajuda e Ciência</button></nav><div class="bp14-scroll">
<section class="bp14-panel active" data-bp14-panel="measure"><div class="bp14-status"><div class="cell"><small>Sensores</small><strong id="bp14Sensor">Desligados</strong></div><div class="cell"><small>GPS</small><strong id="bp14Gps">Desligado</strong></div><div class="cell"><small>Precisão GPS</small><strong id="bp14Acc">—</strong></div><div class="cell"><small>Estabilidade</small><strong id="bp14Stable">—</strong></div></div>
<div class="bp14-measure-grid"><div class="bp14-card bp14-compass-card"><div class="bp14-dial">${buildTicks()}<span class="bp14-dir n">N</span><span class="bp14-dir e">E</span><span class="bp14-dir s">S</span><span class="bp14-dir w">W</span><div class="bp14-needle" id="bp14Needle"></div><div class="bp14-center"></div></div></div><div><div class="bp14-readings"><div class="bp14-reading nm"><span class="bp14-label">Azimute magnético Nm</span><strong id="bp14Nm">—</strong><em id="bp14NmDir">sensor</em></div><div class="bp14-reading ng"><span class="bp14-label">Azimute geográfico Ng</span><strong id="bp14Ng">—</strong><em id="bp14NgDir">requer declinação</em></div><div class="bp14-reading good"><span class="bp14-label">Inclinação</span><strong id="bp14Tilt">—</strong><em>plano da tela</em></div><div class="bp14-reading disp"><span class="bp14-label">Dispersão</span><strong id="bp14Disp">—</strong><em id="bp14DispTxt">—</em></div></div><div class="bp14-quality warn" id="bp14Quality">● Ative os sensores para iniciar</div><div class="bp14-actions"><button class="bp14-btn primary" id="bp14Start">Ativar sensores</button><button class="bp14-btn" id="bp14GpsBtn">Ativar localização</button><button class="bp14-btn" id="bp14Lock" disabled>Travar leitura</button><button class="bp14-btn" id="bp14Cal">Zerar dispersão</button></div><button class="bp14-btn primary bp14-save" id="bp14Save" disabled>Salvar medição</button></div></div><div class="bp14-note">Leitura assistida. Afaste o aparelho de metal, ímãs, cabos energizados e outros equipamentos eletrônicos. Estabilidade não garante ausência de interferência magnética local.</div></section>
<section class="bp14-panel" data-bp14-panel="data"><div class="bp14-section"><h3>Localização e contexto</h3><div class="bp14-info-grid"><div class="bp14-data-card"><span class="bp14-label">Latitude</span><strong id="bp14Lat">—</strong><small>WGS84</small></div><div class="bp14-data-card"><span class="bp14-label">Longitude</span><strong id="bp14Lon">—</strong><small>WGS84</small></div><div class="bp14-data-card"><span class="bp14-label">Altitude GNSS</span><strong id="bp14Alt">—</strong><small id="bp14AltNote">quando disponível</small></div><div class="bp14-data-card"><span class="bp14-label">Precisão horizontal</span><strong id="bp14HAcc">—</strong><small>estimativa do navegador</small></div><div class="bp14-data-card"><span class="bp14-label">Precisão vertical</span><strong id="bp14VAcc">—</strong><small>quando fornecida pelo dispositivo</small></div><div class="bp14-data-card"><span class="bp14-label">Data · hora</span><strong id="bp14Time">—</strong><small>hora local</small></div></div><div class="bp14-actions"><button class="bp14-btn primary" id="bp14GpsBtn2">Ativar localização</button></div></div><div class="bp14-section"><h3>Registro da medição</h3><div class="bp14-field"><label>Tipo de elemento</label><select id="bp14Type"><option>Plano</option><option>Fratura</option><option>Falha</option><option>Folição</option><option>Contato</option><option>Veio</option><option>Lineação</option><option>Outro</option></select></div><div class="bp14-field"><label>Observação</label><textarea id="bp14Obs" rows="4" placeholder="Descrição geológica opcional"></textarea></div></div></section>
<section class="bp14-panel" data-bp14-panel="north"><div class="bp14-section"><h3>Referência do norte</h3><div class="bp14-north-grid"><div class="bp14-north"><span class="bp14-label">Norte magnético Nm</span><strong id="bp14Nm2">—</strong><small>leitura do sensor</small></div><div class="bp14-north"><span class="bp14-label">Declinação δ</span><strong id="bp14DeclShow">—</strong><small>Leste positivo · Oeste negativo</small></div><div class="bp14-north"><span class="bp14-label">Norte geográfico Ng</span><strong id="bp14Ng2">—</strong><small>calculado quando δ é conhecida</small></div></div><div class="bp14-formula">Ng = (Nm + δ) mod 360°. O valor original Nm é sempre preservado no registro.</div><div class="bp14-field"><label>Declinação local δ °</label><input id="bp14Decl" type="number" step="0.1" inputmode="decimal" placeholder="Ex. -18,4 para Oeste"></div><div class="bp14-field"><label>Fonte da declinação</label><input id="bp14DeclSource" placeholder="Ex. WMM2025, carta, levantamento"></div><div class="bp14-note"><b>WMM2025</b> é o modelo global vigente para 2025–2029. Nesta versão, ITA ARANDU não consulta uma página externa nem inventa δ. A correção automática só deve ser ativada quando o módulo oficial completo estiver incorporado e validado. Até lá, informe a declinação documentada e sua fonte.</div></div></section>
<section class="bp14-panel" data-bp14-panel="help"><div class="bp14-section bp14-help"><h3>Ajuda e Ciência</h3><h4>Como medir</h4><p>Ative os sensores por gesto explícito, mantenha o telefone afastado de fontes de interferência e aguarde a dispersão estabilizar. Repita leituras sempre que a direção for crítica.</p><h4>Fonte do rumo</h4><p>ITA ARANDU prioriza orientação absoluta quando o navegador a disponibiliza. Em dispositivos compatíveis, também utiliza webkitCompassHeading. Se apenas orientação relativa estiver disponível, a interface informa essa limitação.</p><h4>Controle de qualidade</h4><p>A dispersão é calculada com estatística circular sobre as leituras recentes. Uma dispersão baixa indica repetibilidade, não exatidão absoluta.</p><h4>Norte magnético e geográfico</h4><p>O azimute magnético é mantido sem alteração. Quando existe declinação documentada, o azimute geográfico é calculado por Ng = Nm + δ, normalizado entre 0° e 360°.</p><h4>GPS e altitude</h4><p>Latitude e longitude são coordenadas WGS84 fornecidas pela API de geolocalização. A altitude é a altitude GNSS fornecida pelo dispositivo quando disponível e não deve ser confundida automaticamente com cota ortométrica ou altitude topográfica de precisão.</p><h4>Limitações</h4><p>Capas, ímãs, estruturas metálicas, veículos, linhas elétricas, rochas fortemente magnéticas e diferenças entre sensores e navegadores podem afetar o rumo. Para levantamentos de precisão, compare com instrumento de referência e registre o método.</p><h4>Referência geomagnética</h4><p>World Magnetic Model 2025, NOAA NCEI e British Geological Survey. Modelo válido para 2025.0–2030.0. A documentação científica completa deve permanecer vinculada à biblioteca geral do projeto.</p></div></section>
</div></div>`}
function tab(name){document.querySelectorAll('#bussolaAranduModal .bp14-tab').forEach(b=>b.classList.toggle('active',b.dataset.bp14Tab===name));document.querySelectorAll('#bussolaAranduModal .bp14-panel').forEach(p=>p.classList.toggle('active',p.dataset.bp14Panel===name))}
function render(){const q=quality(),ng=trueHeading();if($('bp14Nm'))$('bp14Nm').textContent=Number.isFinite(S.heading)?S.heading.toFixed(1)+'°':'—';if($('bp14NmDir'))$('bp14NmDir').textContent=Number.isFinite(S.heading)?dir16(S.heading)+' · '+S.source:'sensor';if($('bp14Ng'))$('bp14Ng').textContent=Number.isFinite(ng)?ng.toFixed(1)+'°':'—';if($('bp14NgDir'))$('bp14NgDir').textContent=Number.isFinite(ng)?dir16(ng)+' · corrigido':'requer declinação';if($('bp14Tilt'))$('bp14Tilt').textContent=Number.isFinite(S.tilt)?S.tilt.toFixed(1)+'°':'—';if($('bp14Disp'))$('bp14Disp').textContent=Number.isFinite(q.sd)?q.sd.toFixed(1)+'°':'—';if($('bp14DispTxt'))$('bp14DispTxt').textContent=q.label;if($('bp14Quality')){$('bp14Quality').className='bp14-quality '+q.cls;$('bp14Quality').textContent='● '+q.label+(S.absolute?' · referência absoluta':' · referência não confirmada')};if($('bp14Stable')){$('bp14Stable').textContent=q.label;$('bp14Stable').className=q.cls==='bad'?'bp14-bad':q.cls==='warn'?'bp14-warn':'bp14-ok'}if($('bp14Needle')&&Number.isFinite(S.heading))$('bp14Needle').style.transform=`translate(-50%,-100%) rotate(${S.heading}deg)`;if($('bp14Nm2'))$('bp14Nm2').textContent=Number.isFinite(S.heading)?S.heading.toFixed(1)+'°':'—';if($('bp14Ng2'))$('bp14Ng2').textContent=Number.isFinite(ng)?ng.toFixed(1)+'°':'—';if($('bp14DeclShow'))$('bp14DeclShow').textContent=Number.isFinite(S.decl)?`${S.decl>=0?'+':''}${S.decl.toFixed(1)}°`:'—';if($('bp14Sensor')){$('bp14Sensor').textContent=S.active?'Ativos':'Desligados';$('bp14Sensor').className=S.active?'bp14-ok':''};if($('bp14Start'))$('bp14Start').textContent=S.active?'Parar sensores':'Ativar sensores';if($('bp14Lock'))$('bp14Lock').disabled=!S.active;if($('bp14Save'))$('bp14Save').disabled=!Number.isFinite(S.heading);renderGps()}
function renderGps(){const g=S.gps;if($('bp14Gps')){$('bp14Gps').textContent=S.gpsActive?'Ativo':'Desligado';$('bp14Gps').className=S.gpsActive?'bp14-ok':''};if($('bp14GpsBtn'))$('bp14GpsBtn').textContent=S.gpsActive?'Parar localização':'Ativar localização';if($('bp14GpsBtn2'))$('bp14GpsBtn2').textContent=S.gpsActive?'Parar localização':'Ativar localização';const set=(id,v)=>{if($(id))$(id).textContent=v};set('bp14Acc',g?.accuracy?`± ${Math.round(g.accuracy)} m`:'—');set('bp14Lat',Number.isFinite(g?.latitude)?g.latitude.toFixed(6)+'°':'—');set('bp14Lon',Number.isFinite(g?.longitude)?g.longitude.toFixed(6)+'°':'—');set('bp14Alt',Number.isFinite(g?.altitude)?Math.round(g.altitude)+' m':'—');set('bp14HAcc',Number.isFinite(g?.accuracy)?`± ${Math.round(g.accuracy)} m`:'—');set('bp14VAcc',Number.isFinite(g?.altitudeAccuracy)?`± ${Math.round(g.altitudeAccuracy)} m`:'—');set('bp14Time',new Date().toLocaleString('pt-BR'));if($('bp14AltNote'))$('bp14AltNote').textContent=Number.isFinite(g?.altitude)?'altitude fornecida pelo GNSS':'não fornecida pelo dispositivo'}
function onOrientation(e){if(!S.active||S.locked)return;const x=headingFrom(e);S.beta=Number(e.beta);S.gamma=Number(e.gamma);S.tilt=planeTilt(S.beta,S.gamma);S.absolute=x.abs;S.source=x.src;if(Number.isFinite(x.h)){S.samples.push(x.h);if(S.samples.length>60)S.samples.shift();S.heading=circStats(S.samples.slice(-5)).mean}render()}
async function startSensors(){if(S.active){stopSensors();return}try{if(typeof DeviceOrientationEvent?.requestPermission==='function'){const p=await DeviceOrientationEvent.requestPermission();if(p!=='granted')throw new Error('Permissão negada')}window.addEventListener('deviceorientationabsolute',onOrientation,true);window.addEventListener('deviceorientation',onOrientation,true);S.active=true;render()}catch(err){alert('Não foi possível ativar os sensores. Verifique permissões e compatibilidade do navegador.');S.active=false;render()}}
function stopSensors(){window.removeEventListener('deviceorientationabsolute',onOrientation,true);window.removeEventListener('deviceorientation',onOrientation,true);S.active=false;S.locked=false;render()}
function toggleGps(){if(S.gpsActive){navigator.geolocation?.clearWatch(S.watch);S.watch=null;S.gpsActive=false;render();return}if(!navigator.geolocation){alert('Geolocalização não disponível neste navegador.');return}S.gpsActive=true;S.watch=navigator.geolocation.watchPosition(p=>{const c=p.coords;S.gps={latitude:c.latitude,longitude:c.longitude,altitude:c.altitude,accuracy:c.accuracy,altitudeAccuracy:c.altitudeAccuracy,heading:c.heading,speed:c.speed,ts:p.timestamp};renderGps()},()=>{S.gpsActive=false;render();alert('Não foi possível obter a localização. Verifique a permissão do navegador.')},{enableHighAccuracy:true,maximumAge:2000,timeout:12000});render()}
function save(){if(!Number.isFinite(S.heading)){alert('Ative os sensores antes de salvar.');return}const q=quality(),rec={ts:new Date().toISOString(),azimuth_magnetic:S.heading,declination:Number.isFinite(S.decl)?S.decl:null,azimuth_geographic:trueHeading(),inclination:S.tilt,dispersion:q.sd,quality:q.label,absolute:S.absolute,orientation_source:S.source,latitude:S.gps?.latitude??null,longitude:S.gps?.longitude??null,altitude_gnss:S.gps?.altitude??null,gps_accuracy:S.gps?.accuracy??null,altitude_accuracy:S.gps?.altitudeAccuracy??null,declination_source:$('bp14DeclSource')?.value?.trim()||null,type:$('bp14Type')?.value||'Plano',observation:$('bp14Obs')?.value?.trim()||''};let a=[];try{a=JSON.parse(localStorage.getItem('ita_arandu_compass_measurements')||'[]')}catch{}a.unshift(rec);localStorage.setItem('ita_arandu_compass_measurements',JSON.stringify(a.slice(0,200)));if(typeof window.itaCampoAddMeasure==='function')try{window.itaCampoAddMeasure({type:rec.type,azimuth:rec.azimuth_geographic??rec.azimuth_magnetic,dip:rec.inclination,method:'bússola geológica',quality:rec.quality,note:rec.observation})}catch{}alert('Medição salva com dados de orientação'+(S.gps?' e localização.':'.'))}
function closeCompass(){
  stopSensors();
  if(S.gpsActive){navigator.geolocation?.clearWatch(S.watch);S.watch=null;S.gpsActive=false}
  const m=$('bussolaAranduModal');
  if(m){m.classList.remove('open');m.setAttribute('aria-hidden','true')}
  document.body.classList.remove('modal-open');
}
function mount(){
  const m=$('bussolaAranduModal');
  if(!m)return;
  m.innerHTML=html();
  m.dataset.bp14='1';
  m.querySelectorAll('.bp14-tab').forEach(b=>b.addEventListener('click',()=>tab(b.dataset.bp14Tab)));
  $('bp14Back')?.addEventListener('click',closeCompass);
  $('bp14Start')?.addEventListener('click',startSensors);
  $('bp14GpsBtn')?.addEventListener('click',toggleGps);
  $('bp14GpsBtn2')?.addEventListener('click',toggleGps);
  $('bp14Lock')?.addEventListener('click',()=>{S.locked=!S.locked;$('bp14Lock').textContent=S.locked?'Destravar leitura':'Travar leitura'});
  $('bp14Cal')?.addEventListener('click',()=>{S.samples=[];render()});
  $('bp14Save')?.addEventListener('click',save);
  $('bp14Decl')?.addEventListener('input',e=>{const t=String(e.target.value).trim().replace(',','.');S.decl=t===''?null:Number(t);if(!Number.isFinite(S.decl))S.decl=null;render()});
  tab('measure');
  render();
}
function normalizeRose(){const card=[...document.querySelectorAll('.ita-tool-card')].find(c=>/Diagrama de Rosas/i.test(c.textContent));if(!card)return;const actions=card.querySelector('.ita-tool-actions');if(actions){[...actions.querySelectorAll('button,a')].forEach((el,i)=>{if(i>0)el.remove()});const first=actions.querySelector('button,a');if(first){first.style.width='100%';first.classList.add('primary')}}}
function init(){mount();normalizeRose()}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
window.ITA_BUSSOLA_PRO_R14={version:'14.4',mount,close:closeCompass};
})();