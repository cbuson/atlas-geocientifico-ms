/* ITA ARANDU MS · Bússola Geológica Profissional R14 */
#bussolaAranduModal .modal-box.ita-bp14{width:min(980px,96vw);max-width:980px;height:min(92dvh,920px);max-height:92dvh;display:flex;flex-direction:column;overflow:hidden;background:#fff}
#bussolaAranduModal .bp14-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:18px 22px 14px;border-bottom:1px solid #d6e2e8;flex:0 0 auto}
#bussolaAranduModal .bp14-kicker{font-size:12px;letter-spacing:.13em;font-weight:800;color:#617c8a;text-transform:uppercase}
#bussolaAranduModal .bp14-head h2{margin:4px 0 0;font-size:27px;line-height:1.08;color:#083f5b}
#bussolaAranduModal .bp14-close{border:0;background:#e6f0f5;color:#0b4d6a;border-radius:14px;width:52px;height:52px;font-size:27px;font-weight:900;cursor:pointer}
#bussolaAranduModal .bp14-tabs{display:flex;gap:10px;padding:12px 16px;border-bottom:1px solid #d6e2e8;overflow-x:auto;scrollbar-width:none;flex:0 0 auto;background:#fff}
#bussolaAranduModal .bp14-tabs::-webkit-scrollbar{display:none}
#bussolaAranduModal .bp14-tab{border:1px solid #c8d8e1;background:#fff;color:#0b4d6a;border-radius:999px;padding:11px 18px;font-weight:800;white-space:nowrap;cursor:pointer;min-height:46px}
#bussolaAranduModal .bp14-tab.active{background:#0f628f;color:#fff;border-color:#0f628f}
#bussolaAranduModal .bp14-scroll{overflow-y:auto;overscroll-behavior:contain;padding:16px 18px 22px;flex:1 1 auto;-webkit-overflow-scrolling:touch}
#bussolaAranduModal .bp14-panel{display:none}.bp14-panel.active{display:block}
#bussolaAranduModal .bp14-status{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}
#bussolaAranduModal .bp14-status .cell,.bp14-card{border:1px solid #d5e1e7;border-radius:16px;background:#fff;padding:12px 14px}
#bussolaAranduModal .bp14-status small,.bp14-label{display:block;color:#68808c;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.03em}
#bussolaAranduModal .bp14-status strong{display:block;color:#083f5b;font-size:18px;margin-top:3px}.bp14-ok{color:#12843a!important}.bp14-warn{color:#9a7415!important}.bp14-bad{color:#b3261e!important}
#bussolaAranduModal .bp14-measure-grid{display:grid;grid-template-columns:minmax(320px,1.2fr) minmax(250px,.8fr);gap:16px;align-items:start}
#bussolaAranduModal .bp14-compass-card{padding:14px}
#bussolaAranduModal .bp14-dial{position:relative;aspect-ratio:1/1;width:min(100%,520px);margin:auto;border:3px solid #0b4d6a;border-radius:50%;background:radial-gradient(circle at center,#fff 0 55%,#fbfdfe 100%)}
#bussolaAranduModal .bp14-tick{position:absolute;left:50%;top:50%;width:1px;height:48%;transform-origin:50% 100%;background:linear-gradient(to top,transparent 0 82%,#9db4c0 82% 100%);opacity:.75}
#bussolaAranduModal .bp14-tick.major{width:1.5px;background:linear-gradient(to top,transparent 0 76%,#587b8d 76% 100%)}
#bussolaAranduModal .bp14-dir{position:absolute;font-weight:900;color:#123f57;font-size:22px;transform:translate(-50%,-50%)}
#bussolaAranduModal .bp14-dir.n{left:50%;top:10%;color:#d71920}.bp14-dir.e{left:90%;top:50%}.bp14-dir.s{left:50%;top:90%}.bp14-dir.w{left:10%;top:50%}
#bussolaAranduModal .bp14-deg{position:absolute;font-size:12px;font-weight:800;color:#244f64;transform:translate(-50%,-50%)}
#bussolaAranduModal .bp14-needle{position:absolute;left:50%;top:50%;width:12px;height:35%;transform-origin:50% 100%;transform:translate(-50%,-100%) rotate(0deg);border-radius:8px;background:linear-gradient(to top,#0b4d6a 0 53%,#d71920 53% 100%);z-index:3;transition:transform .12s linear}
#bussolaAranduModal .bp14-center{position:absolute;left:50%;top:50%;width:30px;height:30px;transform:translate(-50%,-50%);border:6px solid #0b4d6a;background:#fff;border-radius:50%;z-index:4}
#bussolaAranduModal .bp14-readings{display:grid;grid-template-columns:1fr 1fr;gap:10px}.bp14-reading{border:1px solid #d5e1e7;border-radius:16px;padding:14px;background:#fff}.bp14-reading strong{display:block;font-size:35px;color:#083f5b;line-height:1.05;margin-top:6px}.bp14-reading em{font-style:normal;color:#6a7f89;font-size:13px}.bp14-reading.nm{border-top:4px solid #d71920}.bp14-reading.ng{border-top:4px solid #1480b5}.bp14-reading.good{border-top:4px solid #168a3d}.bp14-reading.disp{border-top:4px solid #7656b1}
#bussolaAranduModal .bp14-quality{margin-top:10px;padding:12px 14px;border-radius:14px;background:#eff8f1;color:#126a31;font-weight:850}.bp14-quality.warn{background:#fff7df;color:#826315}.bp14-quality.bad{background:#fff0ef;color:#a1241e}
#bussolaAranduModal .bp14-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}.bp14-btn{border:1px solid #bcd0da;background:#fff;color:#0b4d6a;border-radius:12px;padding:11px 14px;font-weight:800;cursor:pointer}.bp14-btn.primary{background:#0f628f;color:#fff;border-color:#0f628f}.bp14-btn:disabled{opacity:.45;cursor:not-allowed}
#bussolaAranduModal .bp14-save{width:100%;font-size:18px;padding:14px;margin-top:10px}
#bussolaAranduModal .bp14-info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.bp14-data-card{border:1px solid #d5e1e7;border-radius:16px;padding:14px}.bp14-data-card strong{display:block;font-size:22px;color:#083f5b;margin-top:4px;word-break:break-word}.bp14-data-card small{color:#6b7e87}
#bussolaAranduModal .bp14-section{border:1px solid #d5e1e7;border-radius:18px;padding:16px;margin-bottom:14px}.bp14-section h3{margin:0 0 12px;color:#083f5b;font-size:20px}
#bussolaAranduModal .bp14-north-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.bp14-north{border:1px solid #d5e1e7;border-radius:16px;padding:14px}.bp14-north strong{display:block;font-size:30px;color:#083f5b;margin-top:5px}
#bussolaAranduModal .bp14-formula{padding:12px 14px;background:#edf5f8;border-radius:12px;color:#254e61;margin-top:10px;font-weight:750}
#bussolaAranduModal .bp14-field{display:grid;gap:6px;margin-top:12px}.bp14-field input,.bp14-field textarea,.bp14-field select{width:100%;border:1px solid #bfd1da;border-radius:12px;padding:12px;font:inherit;background:#fff;color:#163f53}.bp14-field label{font-weight:800;color:#224e62}
#bussolaAranduModal .bp14-help{color:#294d5d;line-height:1.55}.bp14-help h4{color:#083f5b;margin:14px 0 5px}.bp14-help p{margin:0 0 9px}
#bussolaAranduModal .bp14-note{background:#fff8e7;border:1px solid #e8d69c;border-radius:14px;padding:12px 14px;color:#67551b;margin-top:12px}
@media(max-width:700px){
 #bussolaAranduModal .modal-box.ita-bp14{width:100vw;height:100dvh;max-height:100dvh;border-radius:0}
 #bussolaAranduModal .bp14-head{padding:14px 18px 12px}.bp14-head h2{font-size:25px!important}.bp14-close{width:48px!important;height:48px!important}
 #bussolaAranduModal .bp14-tabs{padding:10px 16px}.bp14-tab{padding:10px 16px!important}
 #bussolaAranduModal .bp14-scroll{padding:14px 16px 24px}
 #bussolaAranduModal .bp14-status{grid-template-columns:1fr 1fr}.bp14-measure-grid{grid-template-columns:1fr!important}.bp14-dial{width:min(92vw,500px)!important}.bp14-readings{grid-template-columns:1fr 1fr!important}
 #bussolaAranduModal .bp14-info-grid{grid-template-columns:1fr 1fr}.bp14-north-grid{grid-template-columns:1fr}
 #bussolaAranduModal .bp14-actions .bp14-btn{flex:1 1 42%}
}
